{
  "name": "watchflow",
  "version": "0.14.0",
  "private": true,
  "description": "WatchFlow — quản lý cửa hàng đồng hồ",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/db/pg.mjs start --quiet && next dev -p 3000",
    "build": "node scripts/check-version.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node scripts/test-api.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "db:start": "node scripts/db/pg.mjs start",
    "db:stop": "node scripts/db/pg.mjs stop",
    "db:status": "node scripts/db/pg.mjs status",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:staging": "node scripts/db/migrate.mjs --env staging",
    "db:migrate:production": "node scripts/db/migrate.mjs --env production",
    "db:seed": "node scripts/db/seed.mjs",
    "db:audit": "node scripts/db/audit.mjs",
    "db:backup": "node scripts/db/backup.mjs",
    "db:restore-drill": "node scripts/db/restore-drill.mjs",
    "db:sql": "node scripts/db/sql.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:reset": "node scripts/setup-local.mjs --reset",
    "env:keys": "node scripts/env/gen-keys.mjs",
    "dev:staging": "node scripts/env/dev-staging.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "audit:layout": "node scripts/e2e/layout-audit.mjs",
    "docs:guide": "node --no-warnings scripts/docs/export-guide.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "exceljs": "4.4.0",
    "exifr": "^7.1.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "otpauth": "^9.5.2",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "sharp"
    ]
  }
}
